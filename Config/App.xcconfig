// ============================================================
// YDS Kelimelerim — tek noktadan yapılandırma
//
// Değiştirilmesi gereken her şey burada. Kaynak kodda hiçbir
// kimlik, anahtar veya sürüm numarası gömülü değildir.
//
// DİKKAT: xcconfig dosyalarında "//" yorum başlatır. Reklam birimi
// kimliklerinde tek "/" bulunur, sorun çıkarmaz; ancak buraya URL
// yazmanız gerekirse "//" dizisini kaçırmak zorundasınız.
// ============================================================

// ---------- Kimlik ----------
APP_BUNDLE_ID = com.ustuner.ydskelimelerim
APP_DISPLAY_NAME = YDS Kelimelerim
APP_GROUP_ID = group.com.ustuner.ydskelimelerim

// ---------- Sürüm ----------
// MARKETING_VERSION      : App Store'da görünen sürüm (1.0.0)
// CURRENT_PROJECT_VERSION: her yüklemede artması gereken derleme numarası
// CI derleme numarasını otomatik artırır; elle derlerken siz artırın.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// ---------- İmzalama ----------
// DEVELOPMENT_TEAM: Apple Developer hesabınızın 10 haneli Team ID'si.
// Bulunduğu yer: developer.apple.com > Membership Details > Team ID
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY_APP = Apple Distribution
APP_PROVISIONING_PROFILE = YDSKelimelerim AppStore
WIDGET_PROVISIONING_PROFILE = YDSKelimelerim Widget AppStore

// ---------- AdMob ----------
// AdMob panelinden alınır: apps.admob.com > Uygulamalar > Uygulama ayarları
// Aşağıdakiler GOOGLE'IN RESMİ TEST KİMLİKLERİDİR. Geliştirme sırasında
// bunları kullanın; kendi kimliğinizle test reklamı istemek hesabınızın
// geçersiz trafik nedeniyle askıya alınmasına yol açar.
//
// Yayına çıkmadan önce üçünü de kendi kimliklerinizle değiştirin.
ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
ADMOB_BANNER_QUIZ = ca-app-pub-3940256099942544/2435281174
ADMOB_BANNER_RESULT = ca-app-pub-3940256099942544/2435281174
ADMOB_BANNER_LIST = ca-app-pub-3940256099942544/2435281174

// Reklamların derlemeye dâhil edilip edilmeyeceği.
// NO yaparsanız SDK hiç başlatılmaz, hiçbir reklam alanı çizilmez.
// Ekran görüntüsü alırken ve App Store incelemesi öncesi denemek için kullanışlı.
ADS_ENABLED = YES
